{
  "item": [
    {
      "id": "f84b9e92-5129-4a02-b845-a0d512d23ec5",
      "name": "Candidate Attributes API",
      "description": {
        "content": "List and create candidate (lead) custom attribute definitions at the company level. Definitions appear in the recruiter UI and can be written on leads via the `others` field using the attribute key. Both built-in (`default`) and custom attributes are returned on list.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "3c985f8c-05ca-42af-94dd-d3a1f3d6324d",
          "name": "List all candidate attribute definitions",
          "request": {
            "name": "List all candidate attribute definitions",
            "description": {
              "content": "Returns every attribute definition for the company, including default (system) and custom attributes, ordered by `name`. Use this to drive integrations and to discover keys for the leads `others` payload.\n\nEach item includes type, suggested values, visibility flags, and whether the attribute is a default (built-in) field (`default: true`) or a custom one (`default: false`).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "company",
                "candidate_attributes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) The API key provided for your application."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
