        {
          "id": "66dedc5b-29a3-4fc2-8cd0-d00d523963e8",
          "name": "Create a custom candidate attribute",
          "request": {
            "name": "Create a custom candidate attribute",
            "description": {
              "content": "Creates a new **custom** attribute definition. It becomes available in the UI immediately and is writable on leads through the `others` field using the persisted key (custom keys are stored with an `others.` prefix where applicable).\n\n**Duplicate prevention:** If the normalized `key` already exists for an attribute, the API returns **409 Conflict** (not a second record).\n\n**Required fields:** `name` and `key` (see request schema). `data_type` defaults to `text` when omitted.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "company",
                "candidate_attributes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) The API key provided for your application."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"candidate_attribute\": {\n    \"name\": \"<string>\",\n    \"key\": \"<string>\",\n    \"data_type\": \"text\",\n    \"description\": \"<string>\",\n    \"suggested_values\": [\n      \"<string>\",\n      \"<string>\"\n    ],\n    \"allow_only_suggested_values\": \"<boolean>\",\n    \"auto_add_to_all_candidates\": \"<boolean>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "c29e56d2-7221-4a3b-9e2e-f9de322817db",
              "name": "The attribute was created successfully. The body contains the full definition under `candidate_attribute`, including `id`.",
              "originalRequest": {
                "url": {
                  "path": [
                    "company",
                    "candidate_attributes"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "api_key",
                      "value": "<string>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"candidate_attribute\": {\n    \"name\": \"Signing Status\",\n    \"key\": \"signing_status\",\n    \"data_type\": \"text\",\n    \"description\": \"Document signing status\",\n    \"suggested_values\": [\n      \"pending\",\n      \"viewed\",\n      \"completed\",\n      \"declined\"\n    ],\n    \"allow_only_suggested_values\": true,\n    \"auto_add_to_all_candidates\": false\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"candidate_attribute\": {\n    \"id\": 724,\n    \"name\": \"string\",\n    \"data_type\": \"string\",\n    \"suggested_values\": [\n      \"string\",\n      \"string\"\n    ],\n    \"allow_only_suggested_values\": false,\n    \"auto_add_to_all_candidates\": false,\n    \"always_show_across_applications\": true,\n    \"private\": true,\n    \"restrict_to_owners\": false,\n    \"default\": true,\n    \"description\": \"string\"\n  }\n}",
