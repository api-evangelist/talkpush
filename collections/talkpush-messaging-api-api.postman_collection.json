        {
          "id": "8a0209c3-508d-4d64-8174-8bc1846729a3",
          "name": "Send a quick reply template to a lead.",
          "request": {
            "name": "Send a quick reply template to a lead.",
            "description": {
              "content": "This endpoint lets you send a quick reply template to a given lead, via a determined channel. The ID of a quick reply template can be retrieved either inside the CRM's Quick Reply Management Screen or via the /messaging/quick_replies endpoint specified below.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "messaging",
                "messages"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
