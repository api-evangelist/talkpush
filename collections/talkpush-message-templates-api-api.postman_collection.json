        {
          "id": "95abb1ac-fad1-41d7-b37d-ef49a20846d6",
          "name": "Update a message template",
          "request": {
            "name": "Update a message template",
            "description": {
              "content": "Partially updates an existing Message Template. Only the fields provided in the request body are changed; omitted fields are left unchanged.\n\n**Content validation:** If `content` is provided, all Handlebars tokens are re-validated. Unknown tokens return a **422** with the list of offending token names.\n\n**Settings merge:** When `settings` is provided, the new values are merged into the existing settings object. The internal `content_state` key is automatically stripped and never returned.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "messaging",
                "templates",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) The API key provided for your application."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "id",
                  "description": "(Required) The ID of the message template to update."
                }
              ]
            },
