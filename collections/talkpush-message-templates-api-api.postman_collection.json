        {
          "id": "16f18e6e-cfd4-4136-96a1-9ca5bdba91af",
          "name": "Create a message template",
          "request": {
            "name": "Create a message template",
            "description": {
              "content": "Creates a new Message Template for the company. The template is immediately available in the UI and can be referenced by autoflows.\n\n**Content format:** The `content` field must use Handlebars syntax for dynamic tokens, e.g. `Hi {{candidate_name}}, your interview for {{job_title}} is confirmed.` All tokens used in `content` are validated against the company's available tokens (see `GET /messaging/tokens`). Unknown tokens return a **422** with the list of offending token names.\n\n**Type:** Use `email`, `sms`, `whatsapp`, or `messenger`. The `calendar` type is not yet supported via the API.\n\n**Required fields:** `name`, `content`, `type`, `sub_type`, `category`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "messaging",
                "templates"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) The API key provided for your application."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"<string>\",\n  \"content\": \"<string>\",\n  \"type\": \"<string>\",\n  \"sub_type\": \"<string>\",\n  \"category\": \"<string>\",\n  \"locale\": \"en\",\n  \"settings\": {\n    \"key_0\": true,\n    \"key_1\": true,\n    \"key_2\": 1834\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
