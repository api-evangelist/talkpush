          "id": "4ad67e83-17ba-4136-94d3-e0e9f82758d1",
          "name": "Retrieve a list of calls within a date range",
          "request": {
            "name": "Retrieve a list of calls within a date range",
            "description": {
              "content": "This endpoint returns a paginated list of calls within the specified date range. Each call record includes the associated app_id. The start_date and end_date parameters are required and must be in DD-MM-YYYY format.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "calls"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) The API key provided for your application."
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<string>",
                  "description": "(Required) Start of the date range filter. Date format must be DD-MM-YYYY (e.g., 01-02-2026). Required."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<string>",
                  "description": "(Required) End of the date range filter. Date format must be DD-MM-YYYY (e.g., 13-02-2026). Required."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "Page number of the results to return. Default is 1."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
