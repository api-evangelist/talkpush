          "name": "Create custom folders",
          "request": {
            "name": "Create custom folders",
            "description": {
              "content": "This endpoint let's you create custom folders in the company account. A common scenario for this endpoint would be to create a custom folder whenever you create a new recruitment process step inside the ATS.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "company",
                "folders"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) The API key provided for your application"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"api_key\": \"<string>\",\n  \"folder\": {\n    \"id\": \"<number>\",\n    \"folder_name\": \"<string>\",\n    \"default\": \"<boolean>\"\n  }\n}",
